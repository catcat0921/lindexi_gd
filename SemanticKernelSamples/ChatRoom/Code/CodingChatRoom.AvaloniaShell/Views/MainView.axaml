<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:CodingChatRoom.AvaloniaShell.ViewModels" xmlns:views="using:CodingChatRoom.AvaloniaShell.Views"
 x:Class="CodingChatRoom.AvaloniaShell.Views.MainView" x:DataType="vm:MainViewModel">
 <Grid ColumnDefinitions="264,*" Background="{StaticResource SurfaceBrush}">
  <Border Background="#F2F5FA" BorderBrush="#E4EAF3" BorderThickness="0,0,1,0">
   <Grid Margin="16,24,16,16" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="36,*" ColumnSpacing="10" Margin="4,0">
     <Border Background="#E1E9FC" CornerRadius="10" Width="36" Height="36">
      <Image Width="26" Height="26" Source="avares://CodingChatRoom.AvaloniaShell/Assets/Icons/CodingChatRoom_48x48.png" />
     </Border>
     <StackPanel Grid.Column="1" Spacing="4">
      <TextBlock Text="CodingChatRoom" FontSize="16" FontWeight="Bold" Foreground="#24334D" />
      <TextBlock Text="{StaticResource ProductSubtitleText}" FontSize="12" Foreground="#62738D" />
     </StackPanel>
    </Grid>
    <Button Grid.Row="1" Classes="Primary" Height="42" HorizontalAlignment="Stretch" Command="{Binding CreateWorkTaskCommand}">
     <StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Width="14" Height="14" Data="M11,3 L13,3 L13,11 L21,11 L21,13 L13,13 L13,21 L11,21 L11,13 L3,13 L3,11 L11,11 Z" /><TextBlock Text="{StaticResource NewWorkTaskText}" /></StackPanel>
    </Button>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8,0">
     <TextBlock Text="{StaticResource WorkTasksText}" Classes="Subtitle" FontWeight="SemiBold" />
     <TextBlock Grid.Column="1" Text="{Binding WorkTasks.Count}" Classes="Subtitle" />
    </Grid>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="-4,-12,-4,0">
     <ItemsControl ItemsSource="{Binding WorkTasks}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:WorkTaskItemViewModel">
        <Border Classes="TaskTile" Classes.Active="{Binding IsActive}" Margin="4,0,4,8">
         <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,36">
          <Button Classes="TaskSelect" Classes.Active="{Binding IsActive}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).ActivateWorkTaskCommand}" CommandParameter="{Binding}">
           <StackPanel Spacing="9">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Chat.WorkspaceStatusText}" FontSize="12" Foreground="#62738D" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Chat.NextRunWorkspacePath}" />
            <StackPanel Orientation="Horizontal" Spacing="7">
             <Ellipse Width="6" Height="6" Fill="#9BA9BC" IsVisible="{Binding !IsWorking}" />
             <Ellipse Width="6" Height="6" Fill="#4E78DC" IsVisible="{Binding IsWorking}" />
             <TextBlock Text="{StaticResource IdleText}" FontSize="12" Foreground="#62738D" IsVisible="{Binding !IsWorking}" />
             <TextBlock Text="{StaticResource WorkingText}" FontSize="11" Foreground="#4E78DC" IsVisible="{Binding IsWorking}" />
            </StackPanel>
           </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="Icon" VerticalAlignment="Top" ToolTip.Tip="{StaticResource MoreActionsText}">
           <PathIcon Width="16" Height="16" Data="M4,10 A2,2 0 1 0 4,14 A2,2 0 1 0 4,10 M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 M20,10 A2,2 0 1 0 20,14 A2,2 0 1 0 20,10" />
           <Button.Flyout><MenuFlyout>
            <MenuItem Header="{StaticResource RenameWorkTaskText}" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).RenameWorkTaskCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="{StaticResource DeleteSessionText}" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).DeleteWorkTaskCommand}" CommandParameter="{Binding}" />
           </MenuFlyout></Button.Flyout>
          </Button>
          <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DisplayName}" IsVisible="{Binding IsEditing}" Margin="10,0,10,10" />
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="4" Spacing="6">
     <Border Height="1" Background="#E0E7F1" Margin="8,0,8,10" />
     <Button Name="HistoryButton" Classes="Navigation" Classes.Active="{Binding IsHistoryOpen}" Command="{Binding OpenHistoryCommand}"><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="16" Height="16" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 M11,6 L13,6 L13,12 L17,14 L16,16 L11,13 Z" /><TextBlock Text="{StaticResource AllSessionsText}" /></StackPanel></Button>
     <Button Name="SettingsButton" Classes="Navigation" Classes.Active="{Binding IsSettingsOpen}" Command="{Binding OpenSettingsCommand}"><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="16" Height="16" Data="M4,3 L6,3 L6,8 L9,8 L9,10 L6,10 L6,21 L4,21 L4,10 L1,10 L1,8 L4,8 Z M11,3 L13,3 L13,14 L16,14 L16,16 L13,16 L13,21 L11,21 L11,16 L8,16 L8,14 L11,14 Z M18,3 L20,3 L20,6 L23,6 L23,8 L20,8 L20,21 L18,21 L18,8 L15,8 L15,6 L18,6 Z" /><TextBlock Text="{StaticResource SettingsNavigationText}" /></StackPanel></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsChatOpen}">
    <Border Padding="28,16,28,12" BorderBrush="#EEF1F6" BorderThickness="0,0,0,1">
     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
       <TextBlock Text="{Binding ActiveWorkTask.DisplayName}" FontSize="18" FontWeight="SemiBold" MaxWidth="320" TextTrimming="CharacterEllipsis" />
       <Border Background="#EEF2F8" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding !ActiveWorkTask.IsWorking}"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="6" Height="6" Fill="#75859D" /><TextBlock Text="{StaticResource IdleText}" FontSize="12" Foreground="#586A85" /></StackPanel></Border>
       <TextBlock Text="{StaticResource WorkingText}" IsVisible="{Binding ActiveWorkTask.IsWorking}" Foreground="#4E78DC" VerticalAlignment="Center" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
       <TextBlock Text="{StaticResource CurrentSessionText}" Classes="Subtitle" />
       <TextBlock Text="{Binding ChatViewModel.CurrentSessionTitle}" Classes="Subtitle" MaxWidth="420" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Name="NewSessionButton" Classes="Secondary" Content="{StaticResource NewSessionText}" Command="{Binding SessionListViewModel.CreateNewSessionCommand}" />
       <Button Classes="Secondary" Content="{StaticResource SessionListTitle}" Command="{Binding OpenTaskHistoryCommand}" />
       <Button Classes="Danger" Content="{StaticResource StopText}" Command="{Binding ChatViewModel.StopCommand}" IsVisible="{Binding ChatViewModel.IsRunning}" />
      </StackPanel>
     </Grid>
    </Border>
    <views:ChatView Grid.Row="1" DataContext="{Binding ChatViewModel}" />
   </Grid>
   <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsHistoryOpen}">
    <Button Classes="Flat" Margin="24,16" HorizontalAlignment="Left" Content="{StaticResource BackToChatText}" Command="{Binding CloseHistoryCommand}" />
    <views:SessionListView Grid.Row="1" DataContext="{Binding SessionListViewModel}" />
   </Grid>
   <Panel IsVisible="{Binding IsSettingsOpen}"><views:SettingsView DataContext="{Binding SettingsViewModel}" /></Panel>
  </Grid>
 </Grid>
</UserControl>
