<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Styles.Resources>
        <sys:String x:Key="ApplicationTitle">CodingChatRoom 编程助手</sys:String>
        <sys:String x:Key="SessionListTitle">历史会话</sys:String>
        <sys:String x:Key="CurrentSessionText">当前会话</sys:String>
        <sys:String x:Key="NewSessionText">+ 新建</sys:String>
        <sys:String x:Key="EmptySessionListText">暂无匹配的历史会话</sys:String>
        <sys:String x:Key="HistorySearchText">搜索标题或工作路径</sys:String>
        <sys:String x:Key="HistoryLoadingText">正在加载历史会话…</sys:String>
        <sys:String x:Key="BackToChatText">返回聊天</sys:String>
        <sys:String x:Key="EditSessionTitleText">编辑标题</sys:String>
        <sys:String x:Key="OpenSessionText">切换到会话</sys:String>
        <sys:String x:Key="DeleteSessionText">删除</sys:String>
        <sys:String x:Key="SaveTitleText">保存</sys:String>
        <sys:String x:Key="CancelEditText">取消</sys:String>
        <sys:String x:Key="RefreshHistoryText">刷新</sys:String>
        <sys:String x:Key="SettingsNavigationText">设置</sys:String>
        <sys:String x:Key="SessionWorkspaceText">工作路径：</sys:String>
        <sys:String x:Key="ChatTitle">编程助手</sys:String>
        <sys:String x:Key="ChatDescription">会话、工作区和模型发送能力将在后续阶段接入。</sys:String>
        <sys:String x:Key="MessageInputPlaceholder">输入编程问题（Ctrl+Enter 发送）</sys:String>
        <sys:String x:Key="AddImageText">添加图片</sys:String>
        <sys:String x:Key="RemoveImageText">移除图片</sys:String>
        <sys:String x:Key="OpenImageExternallyText">点击使用系统图片查看器打开</sys:String>
        <sys:String x:Key="LoopIterationText">循环迭代</sys:String>
        <sys:String x:Key="AutomaticCompressionText">自动压缩对话</sys:String>
        <sys:String x:Key="StopLanguageServerText">结束 LSP 服务</sys:String>
        <sys:String x:Key="StopLanguageServerToolTip">结束当前工作区的 LSP 服务；运行结束后可用，下次调用符号工具时自动重新启动</sys:String>
        <sys:String x:Key="LanguageServerSettingsTitle">LSP 编程服务</sys:String>
        <sys:String x:Key="LanguageServerSettingsDescription">安装或更新代码符号查询所需的 Roslyn Language Server。</sys:String>
        <sys:String x:Key="InstallOrUpdateLanguageServerText">安装或更新 LSP</sys:String>
        <sys:String x:Key="CopyLanguageServerInstallCommandText">复制命令</sys:String>
        <sys:String x:Key="CopyLanguageServerInstallCommandToolTip">复制安装或更新 LSP 的控制台命令</sys:String>
        <sys:String x:Key="LanguageServerInstallHint">直接执行 dotnet tool update -g roslyn-language-server。</sys:String>
        <sys:String x:Key="EnableDotNetRunText">启用 dotnet run</sys:String>
        <sys:String x:Key="EnableDotNetRunToolTip">下一次新对话运行时包含 dotnet run 工具；当前正在进行的运行不受影响</sys:String>
        <sys:String x:Key="ReasoningEffortToolTip">选择模型的思考强度；默认表示使用模型服务的默认设置</sys:String>
        <sys:String x:Key="SendText">发送</sys:String>
        <sys:String x:Key="CompressConversationText">压缩对话</sys:String>
        <sys:String x:Key="StopText">停止</sys:String>
        <sys:String x:Key="ToolInputText">输入参数</sys:String>
        <sys:String x:Key="ToolOutputText">工具输出</sys:String>
    </Styles.Resources>
</Styles>
