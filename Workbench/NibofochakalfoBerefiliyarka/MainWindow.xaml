<Window x:Class="NibofochakalfoBerefiliyarka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动翻页截图"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI"
        Foreground="#172033">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#93A4C4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Padding="30"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="自动翻页截图" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#64748B"
                           FontSize="13"
                           LineHeight="21"
                           Text="最小化窗口后，自动截取当前页面并发送翻页键。" />

                <Border Margin="0,26,0,0"
                        Padding="16"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="截图次数" />
                            <TextBlock Margin="0,5,12,0"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       Text="每次翻页后等待 1 秒" />
                        </StackPanel>

                        <TextBox x:Name="RepeatCountTextBox"
                                 Grid.Column="1"
                                 Height="40"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Background="White"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 PreviewTextInput="RepeatCountTextBox_OnPreviewTextInput"
                                 Text="10" />
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="14,12"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Foreground="#1E40AF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="键盘接收窗口" />
                        <TextBlock x:Name="TargetWindowTextBlock"
                                   Margin="0,5,0,0"
                                   Foreground="#1E3A8A"
                                   FontSize="13"
                                   Text="正在检测..."
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,14,0,0"
                           Foreground="#64748B"
                           FontSize="12"
                           Text="保存位置：程序目录\图片" />

                <Button x:Name="StartButton"
                        Margin="0,24,0,0"
                        Click="StartButton_OnClick"
                        Content="开始截图"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
